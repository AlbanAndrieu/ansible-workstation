# FastAPI-sample parity: direnv activates a checkout-local .venv.
# Difference: this repo provisions infrastructure, so allow must remain offline.
# Never install dependencies, fetch scripts, unlock secrets, or change Git hooks here.
watch_file mise.toml
watch_file pyproject.toml
watch_file uv.lock
watch_file .python-version

if command -v mise >/dev/null 2>&1; then
  eval "$(mise env -s bash)"
fi

# Only create an EMPTY Python 3.12 venv when absent. Existing environments
# are never overwritten or marked as uv-managed. Missing runtimes skip safely.
if ! bash "$PWD/scripts/ensure-direnv-venv.sh"; then
  log_status 'ansible-workstation: .venv not ready; see diagnostic above'
fi

if [ ! -L "$PWD/.venv" ] && [ -f "$PWD/.venv/pyvenv.cfg" ] && [ -x "$PWD/.venv/bin/python" ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi
