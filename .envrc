# Offline-first direnv: no curl, pip, pyenv, nvm or git writes on directory entry.
# The project runtime is explicitly installed with "mise install" then "uv sync".
# Do not load .env.secrets or execute .env.local as shell code automatically.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise env -s bash)"
fi

# Do not create virtualenv implicitly. uv manages .venv per checkout/worktree.
if [ -d "$PWD/.venv/bin" ]; then
  PATH_add "$PWD/.venv/bin"
fi
