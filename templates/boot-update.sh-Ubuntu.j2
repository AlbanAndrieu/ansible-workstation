#!/bin/bash
# Root part of the boot update (boot-update.service). It never runs a file the user can edit:
# mr, brew, pip, conky and docker compose run in boot-update-user.service (docs/security-workstation.md).
set -uo pipefail

apt-get update || true

# Old snap revisions (was the user-owned nabla/env/linux/cleanup-snap.sh).
LANG=C.UTF-8 snap list --all | awk '/disabled/{print $1, $3}' |
  while read -r name revision; do
    snap remove "${name}" --revision="${revision}" || true
  done

# motion writes as its own user.
rm -f /workspace/Dropbox/motion/*.jpg /workspace/Dropbox/motion/*.mkv

systemctl restart docker

exit 0
