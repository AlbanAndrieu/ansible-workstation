# Managed by ansible-workstation playbooks/restic-backup.yml
# Host metrics for TrueNAS Prometheus (job workstation_node) and the OpenClaw
# heartbeat: default collectors (CPU, memory, filesystems, ZFS) plus systemd unit
# states, the Restic textfile (node_textfile_mtime_seconds of
# /var/lib/restic/last-success.prom) and the Debian textfile directory
# /var/lib/prometheus/node-exporter (apt, docker-health, nvme, smartmon).
# node_exporter >= 1.8 accepts a repeated textfile directory.
# LAN-bound; ufw admits only TrueNAS on 9100 (playbooks/harden-network.yml).
# Carries stabilize_node_exporter_flags (stabilize-workstation.yml) so neither playbook drops the other's.
ARGS="--collector.systemd --collector.textfile --collector.textfile.directory=/var/lib/restic --collector.textfile.directory=/var/lib/prometheus/node-exporter --web.listen-address=172.17.0.57:9100 --collector.cpu --collector.meminfo --collector.loadavg --collector.filesystem"
