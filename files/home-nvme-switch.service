[Unit]
Description=Move /home onto the encrypted NVMe LV, once, before anything writes to it
Requires=dev-vg\x2dnvme\x2dcrypt-home.device
After=dev-vg\x2dnvme\x2dcrypt-home.device local-fs.target
# Everything that may write under /home: logins (and the lingering user manager), Docker bind
# mounts, cron jobs.
Before=systemd-user-sessions.service display-manager.service gdm.service docker.service containerd.service cron.service ollama.service
ConditionPathExists=!/home.sda-old

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/home-nvme-switch /dev/vg-nvme-crypt/home /home /mnt/home-nvme /etc/fstab
# The final rsync scans all of /home before the login screen shows up.
TimeoutStartSec=2h
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
